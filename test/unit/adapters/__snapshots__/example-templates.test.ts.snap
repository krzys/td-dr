<tddr-if test="order.delivery.method == 'pickup'">
<p class="lead" data-v-5880bd4d> Your order is being picked at {{order.delivery.store.name}}. We&#39;ll text you when it&#39;s ready to collect. </p>
</tddr-if>
<tddr-else-if test="order.delivery.method == 'express'">
<p class="lead" data-v-5880bd4d> Express delivery: it should arrive {{order.delivery.eta}}. </p>
</tddr-else-if>
<tddr-else>
<p class="lead" data-v-5880bd4d>We&#39;re packing it now and will send tracking as soon as it ships.</p>
</tddr-else>
