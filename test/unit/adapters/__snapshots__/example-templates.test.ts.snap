<span data-v-42496b38>-{{order.totals.savings}}</span>
</div>
</tddr-if>
<div class="row" data-v-42496b38>
<span data-v-42496b38>Delivery</span>
<span data-v-42496b38>
<tddr-if test="order.delivery.method == 'pickup'">
<!--[-->Free pickup<!--]-->
</tddr-if>
<tddr-else-if test="order.delivery.free">
<!--[-->Free<!--]-->
</tddr-else-if>
<tddr-else>
<!--[-->{{order.totals.delivery}}<!--]-->
</tddr-else>
</span>
</div>
<tddr-if test="order.taxExempt">
<div class="row" data-v-42496b38>
