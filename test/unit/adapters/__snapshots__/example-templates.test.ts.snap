<h3 data-v-98faaefe>Billing</h3>
<p data-v-98faaefe>{{order.billing.name}}<br data-v-98faaefe> {{order.billing.line1}}<br data-v-98faaefe>
<tddr-if test="order.billing.line2">
<!--[-->{{order.billing.line2}}<br data-v-98faaefe>
<!--]-->
</tddr-if> {{order.billing.city}} {{order.billing.postcode}}<br data-v-98faaefe> {{order.billing.country}}</p>
