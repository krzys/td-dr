<br data-v-3fd42a7a>
<!--]-->
</tddr-if>
<strong data-v-3fd42a7a>{{item.price}}</strong>
</div>
</div>
</tddr-each>
<!--]-->
<div class="totals" data-v-5880bd4d data-v-42496b38>
<div class="row" data-v-42496b38>
<span data-v-42496b38>Subtotal</span>
<span data-v-42496b38>{{order.totals.subtotal}}</span>
</div>
<tddr-if test="order.totals.savings">
